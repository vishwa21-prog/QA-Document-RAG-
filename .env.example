# ---- LLM provider for the "Generation" step ----
# Choose "openai" or "local". If "local", a small HF text2text/causal model is used
# (no API key needed, but slower and lower quality — fine for demos/tests).
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Embeddings ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Re-ranker (cross-encoder) ----
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- OCR ----
TESSERACT_CMD=tesseract
OCR_DPI=300

# ---- Chunking ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---- Retrieval ----
TOP_K_RETRIEVE=20
TOP_K_RERANK=4

# ---- Storage ----
VECTOR_STORE_DIR=data/processed/faiss_index
DOC_STORE_PATH=data/processed/docstore.json
